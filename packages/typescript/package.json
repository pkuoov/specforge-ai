{
  "name": "@testgen/typescript",
  "version": "0.1.0",
  "description": "TypeScript adapter for testgen — AST-based extraction + fast-check property tests",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@testgen/core": "file:../core"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "vitest": ">=1.0.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.1.4",
    "@types/node": "^20.0.0",
    "fast-check": "^3.19.0",
    "typescript": "^6.0.3",
    "vitest": "^1.6.1"
  }
}
